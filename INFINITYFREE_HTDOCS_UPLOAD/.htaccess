# CatCyberShop Security Rules
# Block direct HTTP access to JSON data files, logs, and markdown
<FilesMatch \.(json|log|md)$>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes
